{
  "name": "fitlife-ai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "expo start --clear"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-linking": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-font": "~13.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-camera": "~16.0.0",
    "expo-media-library": "~17.0.0",
    "expo-notifications": "~0.29.0",
    "expo-secure-store": "~14.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-haptics": "~14.0.0",
    "expo-web-browser": "~14.0.0",
    "expo-crypto": "~14.0.0",
    "expo-file-system": "~18.0.0",
    "expo-av": "~15.0.0",
    "expo-sqlite": "~15.0.0",

    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "~4.4.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-svg": "15.8.0",
    "react-native-circular-progress": "^1.4.0",

    "nativewind": "^4.1.0",
    "tailwindcss": "^3.4.0",

    "@supabase/supabase-js": "^2.47.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react-native-mmkv": "^3.1.0",

    "react-native-health-connect": "^2.0.0",

    "react-native-url-polyfill": "^2.0.0",
    "cross-fetch": "^4.0.0",

    "zustand": "^5.0.0",
    "zod": "^3.24.0",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.0",

    "date-fns": "^4.1.0",

    "lucide-react-native": "^0.460.0",
    "@phosphor-icons/react": "^2.1.0",

    "react-native-markdown-display": "^7.0.2",
    "react-native-confetti-cannon": "^1.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@types/react": "~18.3.0",
    "typescript": "~5.3.0",
    "@expo/config-plugins": "~10.0.0",

    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-expo": "^7.0.0",
    "prettier": "^3.4.0",

    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.0",
    "jest-expo": "~52.0.0",

    "supabase": "^2.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-circular-progress|victory-native|react-native-mmkv|react-native-health-connect|nativewind|@react-native-async-storage/.*|@gorhom/bottom-sheet)"
    ],
    "setupFilesAfterSetup": ["<rootDir>/jest.setup.ts"]
  },
  "private": true
}
