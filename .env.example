# ============================================================
# FitLife AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ---- App Environment ----
EXPO_PUBLIC_ENV=development

# ---- Supabase ----
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- AI Providers (Gemini is primary, others are fallbacks) ----
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Sentry (Error Tracking & Performance Monitoring) ----
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxx@o0.ingest.sentry.io/0

# ---- PostHog (Product Analytics) ----
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Health Connect (Android) ----
EXPO_PUBLIC_HEALTH_CONNECT_APP_ID=com.fitlife.ai
